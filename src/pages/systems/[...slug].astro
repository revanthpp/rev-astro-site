---
import { getCollection, render } from 'astro:content';
import SystemFlow from '../../components/SystemFlow.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).filter((project) => !project.data.draft);
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const tableOfContents = headings.filter((heading) => heading.depth <= 3);
const projectFlows: Record<string, Array<{ label: string; detail: string }>> = {
	'agent-native': [
		{ label: 'Discover', detail: 'Collect a bounded set of public business artifacts.' },
		{ label: 'Normalize', detail: 'Map supported interfaces into one internal model.' },
		{ label: 'Check', detail: 'Run 20 deterministic readiness checks with evidence.' },
		{ label: 'Report', detail: 'Validate, sanitize, and render the public findings.' },
	],
	'agent-reliability': [
		{ label: 'Scenario', detail: 'Define the world, authority, fault, and assertions.' },
		{ label: 'Stress', detail: 'Run the agent through a permission-aware gateway.' },
		{ label: 'Evaluate', detail: 'Check state, trajectory, recovery, and truthfulness.' },
		{ label: 'Replay', detail: 'Turn failures into evidence and regression tests.' },
	],
	promptshield: [
		{ label: 'Detect', detail: 'Find sensitive prompt entities locally.' },
		{ label: 'Score', detail: 'Estimate privacy and combination risk.' },
		{ label: 'Protect', detail: 'Block, redact, generalize, or substitute values.' },
		{ label: 'Rehydrate', detail: 'Restore synthetic values locally when useful.' },
	],
	'guardian-llm': [
		{ label: 'Age', detail: 'Map the child to a developmental profile.' },
		{ label: 'Privacy', detail: 'Redact personal data before provider calls.' },
		{ label: 'Policy', detail: 'Score risk and choose a safety decision.' },
		{ label: 'Validate', detail: 'Check the answer before returning it.' },
	],
	'agentops-reference-architecture': [
		{ label: 'Scenario', detail: 'Choose the workflow and constraints.' },
		{ label: 'Route', detail: 'Select a path and model.' },
		{ label: 'Execute', detail: 'Run tools with guardrails.' },
		{ label: 'Evaluate', detail: 'Compare cost, traces, and reliability.' },
	],
	'agents-with-brakes': [
		{ label: 'Policy', detail: 'Set identity, tenant, and permission boundaries.' },
		{ label: 'Tools', detail: 'Gate actions through contracts and approvals.' },
		{ label: 'Evals', detail: 'Measure behavior before and after release.' },
		{ label: 'Rollback', detail: 'Pause, recover, or degrade when runs fail.' },
	],
	'cost-aware-model-router': [
		{ label: 'Task', detail: 'Declare the intended outcome.' },
		{ label: 'Policy', detail: 'Check boundaries and approvals.' },
		{ label: 'Browser', detail: 'Execute the allowed interaction.' },
		{ label: 'Trace', detail: 'Capture evidence for review.' },
	],
	evalkit: [
		{ label: 'Cases', detail: 'Version prompts and scenarios.' },
		{ label: 'Run', detail: 'Exercise the workflow.' },
		{ label: 'Score', detail: 'Classify quality and failures.' },
		{ label: 'Review', detail: 'Make release decisions with evidence.' },
	],
	'llm-observability-dashboard': [
		{ label: 'Failure', detail: 'Name the behavior to reproduce.' },
		{ label: 'Fixture', detail: 'Create a deterministic case.' },
		{ label: 'Trace', detail: 'Inspect where the system drifted.' },
		{ label: 'Mitigate', detail: 'Document the architectural fix.' },
	],
	'secure-tool-calling-sandbox': [
		{ label: 'Request', detail: 'Receive a typed tool call.' },
		{ label: 'Policy', detail: 'Validate identity and scope.' },
		{ label: 'Approve', detail: 'Escalate risky actions to a human.' },
		{ label: 'Audit', detail: 'Record the decision and result.' },
	],
	'mcp-notes-server': [
		{ label: 'Ask', detail: 'Request a note action.' },
		{ label: 'Discover', detail: 'Choose a published MCP tool.' },
		{ label: 'Validate', detail: 'Keep the path inside the workspace.' },
		{ label: 'Notes', detail: 'Read or update Markdown safely.' },
	],
	'a2a-agent-network': [
		{ label: 'Request', detail: 'Submit a structured task.' },
		{ label: 'Discover', detail: 'Read specialist Agent Cards.' },
		{ label: 'Delegate', detail: 'Pass work through the agent chain.' },
		{ label: 'Return', detail: 'Collect the result and trace.' },
	],
	'multi-agent-planner': [
		{ label: 'Goal', detail: 'Receive one planning objective.' },
		{ label: 'Plan', detail: 'Break the goal into ordered tasks.' },
		{ label: 'Execute', detail: 'Complete the tasks and collect outputs.' },
		{ label: 'Review', detail: 'Score the result and record the trace.' },
	],
};
const architectureFlow = projectFlows[project.id] ?? [
	{ label: 'Input', detail: 'Receive a bounded task.' },
	{ label: 'Policy', detail: 'Apply system constraints.' },
	{ label: 'Execute', detail: 'Run the workflow.' },
	{ label: 'Trace', detail: 'Capture evidence.' },
];
---

<SiteLayout
	title={`${project.data.title} | Projects | Revanth Pattipati`}
	description={project.data.description}
>
	<div class="reading-progress" aria-hidden="true"></div>
	<article class="project-detail section-shell">
		<header class="project-header">
			<a class="back-link" href="/systems">Projects</a>
			<div class="project-tags">
				<span class="tag">{project.data.status}</span>
				{project.data.series && <span class="tag">{project.data.series}</span>}
				{project.data.difficulty && <span class="tag">{project.data.difficulty}</span>}
			</div>
			<h1>{project.data.title}</h1>
			<p>{project.data.description}</p>
		</header>

		<section class="architecture-panel" aria-labelledby="architecture-heading">
			<div>
				<p class="kicker">System flow</p>
				<h2 id="architecture-heading">How the pieces move.</h2>
			</div>
			<SystemFlow
				steps={architectureFlow}
				label={`${project.data.title} architecture flow`}
			/>
		</section>

		<div class="detail-grid">
			<section>
				<h2>Problem Statement</h2>
				<p>{project.data.problem}</p>
			</section>
			<section>
				<h2>Architecture Summary</h2>
				<p>{project.data.architecture}</p>
			</section>
			<section>
				<h2>Key Design Tradeoffs</h2>
				<ul>
					{project.data.tradeoffs.map((tradeoff) => <li>{tradeoff}</li>)}
				</ul>
			</section>
			<section>
				<h2>Technologies</h2>
				<div class="tech-list">
					{project.data.technologies.map((tech) => <span>{tech}</span>)}
				</div>
			</section>
		</div>

		<div class:list={['reading-layout', { 'has-toc': tableOfContents.length >= 4 }]}>
			{tableOfContents.length >= 4 && (
				<nav class="table-of-contents" aria-label="Table of contents">
					{tableOfContents.map((heading) => (
						<a href={`#${heading.slug}`}>{heading.text}</a>
					))}
				</nav>
			)}
			<div class="prose">
				<Content />
			</div>
		</div>

		<div class="button-row">
			{project.data.githubUrl && (
				<a class="button" href={project.data.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
			)}
			{project.data.writeupUrl && <a class="button secondary" href={project.data.writeupUrl}>Read write-up</a>}
		</div>
	</article>
</SiteLayout>

<style>
	.project-detail {
		padding: clamp(3.5rem, 7vw, 5.5rem) 0 7rem;
	}

	.project-header {
		display: grid;
		max-width: 980px;
		gap: 1rem;
		margin-bottom: 3rem;
	}

	.project-header h1 {
		font-size: clamp(3rem, 6.5vw, 5.6rem);
	}

	.project-header p {
		color: var(--graphite);
		font-size: 1.2rem;
		line-height: 1.55;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.back-link {
		width: fit-content;
		color: var(--muted);
		font-weight: 700;
		text-decoration: none;
	}

	.architecture-panel {
		display: grid;
		grid-template-columns: minmax(220px, 0.35fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: center;
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--line);
		margin-bottom: 3rem;
		padding: clamp(2.5rem, 6vw, 4.5rem) 0;
	}

	.architecture-panel > div {
		display: grid;
		gap: 0.7rem;
	}

	.architecture-panel h2 {
		font-size: clamp(2rem, 4vw, 3.5rem);
		letter-spacing: -0.04em;
	}

	.detail-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0;
		border-top: 1px solid var(--line-strong);
		border-bottom: 1px solid var(--line);
		margin-bottom: 3rem;
	}

	.detail-grid section {
		padding: 1.5rem;
	}

	.detail-grid section:nth-child(even) {
		border-left: 1px solid var(--line);
	}

	.detail-grid section:nth-child(n + 3) {
		border-top: 1px solid var(--line);
	}

	.detail-grid h2 {
		font-size: 1.25rem;
		margin-bottom: 0.8rem;
	}

	.detail-grid ul {
		color: var(--muted);
		margin: 0;
		padding-left: 1.1rem;
	}

	.tech-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tech-list span {
		border: 1px solid var(--line);
		border-radius: 6px;
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.78rem;
		padding: 0.3rem 0.55rem;
	}

	.reading-layout {
		margin-bottom: 2rem;
	}

	.reading-layout.has-toc {
		display: grid;
		grid-template-columns: 190px minmax(0, 74ch);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
	}

	.table-of-contents {
		position: sticky;
		top: calc(var(--header-height) + 24px);
		display: grid;
		gap: 0.7rem;
		border-left: 2px solid var(--line);
		padding-left: 1rem;
	}

	.table-of-contents a {
		color: var(--muted);
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1.35;
		text-decoration: none;
	}

	.table-of-contents a:hover,
	.table-of-contents a:focus-visible {
		color: var(--accent);
	}

	.prose {
		min-width: 0;
		margin: 0;
	}

	@media (max-width: 760px) {
		.detail-grid,
		.architecture-panel,
		.reading-layout.has-toc {
			grid-template-columns: 1fr;
		}

		.detail-grid section:nth-child(even) {
			border-left: 0;
		}

		.detail-grid section + section {
			border-top: 1px solid var(--line);
		}

		.table-of-contents {
			position: static;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			border-top: 1px solid var(--line);
			border-left: 0;
			padding: 1rem 0;
		}
	}
</style>
