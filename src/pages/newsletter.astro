---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
	title="Futureproof | Revanth Pattipati"
	description="An archived note on Futureproof, Revanth Pattipati's earlier writing project on AI, work, and systems change."
	noindex
>
	<section class="archive-hero section-shell" aria-labelledby="archive-heading">
		<p class="kicker">Archived Project</p>
		<h1 id="archive-heading">Futureproof</h1>
		<p>
			Futureproof was my earlier writing project on AI, work, and systems change. It may come
			back when it has something useful to say. The internet has enough forced newsletters
			already.
		</p>
		<div class="button-row">
			<a class="button" href="/notes">Read current notes</a>
			<a class="button secondary" href="/systems">Explore projects</a>
		</div>
	</section>
</SiteLayout>

<style>
	:global(body.site-body) {
		background: #f6f5f1;
	}

	.archive-hero {
		display: grid;
		gap: 1rem;
		max-width: 850px;
		padding: clamp(5rem, 10vw, 8rem) 0 clamp(5rem, 10vw, 8rem);
	}

	.archive-hero h1 {
		max-width: 800px;
		font-size: clamp(3.6rem, 9vw, 7rem);
		letter-spacing: -0.055em;
	}

	.archive-hero p:not(.kicker) {
		max-width: 650px;
		color: var(--graphite);
		font-size: clamp(1.05rem, 2vw, 1.3rem);
		line-height: 1.65;
		text-wrap: balance;
	}

	@media (max-width: 760px) {
		.archive-hero {
			padding-top: 4.5rem;
		}

		.archive-hero h1 {
			font-size: clamp(3rem, 15vw, 5.5rem);
		}
	}

	@media (max-width: 420px) {
		.archive-hero h1 {
			font-size: clamp(2.75rem, 14.5vw, 4rem);
		}
	}
</style>
