---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getProfile } from '../lib/siteContent';

const profile = getProfile();
const writing = (await getCollection('writing'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projects = (await getCollection('projects')).filter((project) => !project.data.draft);
const latestEssay = writing[0];
const featuredProject = projects.find((project) => project.data.title === 'Agent Native') ?? projects[0];

const editorialLinks = [
	{
		label: 'Main project',
		title: featuredProject.data.title,
		description: 'A passive way to check whether software agents can discover, understand, and safely use a business.',
		href: `/systems/${featuredProject.id}/`,
		link: 'Explore Agent Native',
	},
	{
		label: 'Selected projects',
		title: 'Systems I have built',
		description: 'Working projects across agent reliability, evaluation, secure tool use, and observability.',
		href: '/systems',
		link: 'View projects',
	},
	{
		label: 'Latest writing',
		title: latestEssay.data.title,
		description: 'Clear explanations of what breaks, what works, and what is worth building next.',
		href: `/writing/${latestEssay.id}/`,
		link: 'Read latest article',
	},
	{
		label: 'Background and experience',
		title: 'The path behind the work',
		description: 'Analytics, cloud, infrastructure, and applied AI, plus the useful lessons from each chapter.',
		href: '/about',
		link: 'About me',
	},
];
---

<SiteLayout
	title="Revanth Pattipati | Reliable AI Systems and Agent Architecture"
	description="Revanth Pattipati builds useful, reliable, and accountable AI agents, then writes clearly about what works and what breaks."
>
	<section class="hero section-shell">
		<div class="hero-copy">
			<p class="kicker">Applied AI for the real world</p>
			<h1>I make AI agents more useful, reliable, and accountable.</h1>
			<p>I build systems, test their limits, and write about what I learn when reality gets involved.</p>
			<div class="button-row">
				<a class="button" href="/systems">View projects</a>
				<a class="button secondary" href="/notes">Read my writing</a>
			</div>
		</div>
		<figure class="portrait">
			<img src={profile.images.professional.src} alt={profile.images.professional.alt} />
		</figure>
	</section>

	<section class="directory section-shell" aria-labelledby="directory-heading">
		<header>
			<h2 id="directory-heading">Start here.</h2>
			<p>The work, the writing, and the route that brought me here.</p>
		</header>
		<nav class="editorial-index" aria-label="Homepage highlights">
			{editorialLinks.map((item) => (
				<a class="index-row" href={item.href}>
					<span class="index-label">{item.label}</span>
					<h3>{item.title}</h3>
					<p>{item.description}</p>
					<strong>{item.link}<span aria-hidden="true"> →</span></strong>
				</a>
			))}
		</nav>
	</section>
</SiteLayout>

<style>
	:global(body.site-body) {
		background: #f5f2eb;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 250px;
		gap: clamp(3rem, 6vw, 5rem);
		align-items: center;
		min-height: calc(100dvh - 72px);
		padding: clamp(4rem, 8vw, 6rem) 0;
	}

	.hero-copy {
		display: grid;
		gap: 1.4rem;
	}

	.hero h1 {
		max-width: 920px;
		font-size: clamp(3.5rem, 5vw, 4rem);
		letter-spacing: -0.055em;
		line-height: 0.96;
		text-wrap: balance;
	}

	.hero-copy > p:not(.kicker) {
		max-width: 640px;
		color: var(--graphite);
		font-size: clamp(1.08rem, 1.8vw, 1.3rem);
		line-height: 1.55;
	}

	.portrait {
		margin: 0;
	}

	.portrait img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		border: 1px solid var(--line);
		border-radius: 18px;
		box-shadow: 0 30px 80px rgba(17, 19, 24, 0.13);
		object-fit: cover;
		object-position: center 32%;
	}

	.directory {
		border-top: 1px solid var(--line);
		padding: clamp(4.5rem, 9vw, 7.5rem) 0;
	}

	.directory header {
		display: grid;
		gap: 0.8rem;
		max-width: 680px;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.directory h2 {
		font-size: clamp(2.6rem, 5vw, 4.8rem);
		letter-spacing: -0.045em;
	}

	.directory header p {
		font-size: clamp(1rem, 1.7vw, 1.18rem);
	}

	.editorial-index {
		border-top: 1px solid var(--ink);
	}

	.index-row {
		display: grid;
		grid-template-columns: 170px minmax(210px, 0.8fr) minmax(280px, 1.2fr) max-content;
		gap: clamp(1.25rem, 3vw, 2.5rem);
		align-items: center;
		min-height: 152px;
		color: inherit;
		padding: 1.6rem 1rem;
		text-decoration: none;
		transition:
			background 160ms ease,
			transform 160ms ease;
	}

	.index-row + .index-row {
		border-top: 1px solid var(--line);
	}

	.index-row:hover {
		background: rgba(255, 255, 255, 0.62);
	}

	.index-row:active {
		transform: translateY(1px);
	}

	.index-label {
		color: var(--accent);
		font-family: var(--mono);
		font-size: 0.7rem;
		font-weight: 750;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.index-row h3 {
		font-size: clamp(1.5rem, 2.6vw, 2.35rem);
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.index-row p {
		max-width: 48ch;
		line-height: 1.55;
	}

	.index-row strong {
		color: var(--ink);
		font-size: 0.88rem;
		white-space: nowrap;
	}

	.index-row:hover strong {
		color: var(--accent);
	}

	@media (max-width: 980px) {
		.hero {
			grid-template-columns: minmax(0, 1fr) 220px;
		}

		.index-row {
			grid-template-columns: 150px minmax(0, 1fr);
		}

		.index-row p,
		.index-row strong {
			grid-column: 2;
		}
	}

	@media (max-width: 760px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
		}

		.portrait {
			max-width: 420px;
		}

		.index-row {
			grid-template-columns: 1fr;
			gap: 0.75rem;
			padding: 1.75rem 0.25rem;
		}

		.index-row p,
		.index-row strong {
			grid-column: 1;
		}
	}

	@media (max-width: 520px) {
		.hero h1 {
			font-size: clamp(2.15rem, 8.7vw, 2.8rem);
		}

		.button-row {
			align-items: stretch;
			flex-direction: column;
		}

		.button {
			width: 100%;
		}
	}
</style>
