---
import { getCollection } from 'astro:content';
import SystemFlow from '../components/SystemFlow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getProfile } from '../lib/siteContent';

const profile = getProfile();
const projects = (await getCollection('projects')).filter((project) => !project.data.draft);
const featuredProject = projects.find((project) => project.data.title === 'Agent Reliability') ?? projects[0];

const careerFlow = [
	{ label: 'Analytics', detail: 'Find the signal.' },
	{ label: 'Cloud', detail: 'Make it scale.' },
	{ label: 'Infrastructure', detail: 'Keep it standing.' },
	{ label: 'Applied AI', detail: 'Now add judgment.' },
];

const reliabilityFlow = [
	{ label: 'Scenario', detail: 'Define the task and its boundaries.' },
	{ label: 'Stress', detail: 'Introduce failures and adversarial conditions.' },
	{ label: 'Evaluate', detail: 'Check actions, state, recovery, and truthfulness.' },
	{ label: 'Replay', detail: 'Turn the evidence into a better system.' },
];
---

<SiteLayout
	title="Revanth Pattipati | Practical AI Systems and Agent Reliability"
	description="Revanth Pattipati builds reliable AI agents and explains the architecture, controls, and evidence required to make them useful in the real world."
>
	<section class="hero section-shell">
		<div class="hero-copy">
			<p class="kicker">Applied AI for the real world</p>
			<h1>I build AI agents for the real world.</h1>
			<p>I turn promising AI demos into useful systems with clear controls, evidence, and a plan for when things fail.</p>
			<div class="button-row">
				<a class="button" href="/systems">Explore projects</a>
				<a class="button secondary" href="/notes">Read my writing</a>
			</div>
		</div>
		<figure class="portrait">
			<img src={profile.images.professional.src} alt={profile.images.professional.alt} />
		</figure>
	</section>

	<section class="flagship section-shell" aria-labelledby="flagship-heading">
		<div class="flagship-copy">
			<p class="plain-label">My main project</p>
			<h2 id="flagship-heading">The agent said “done.” I checked.</h2>
			<p>
				Agent Reliability is an open-source harness that stress-tests AI agents with controlled
				failures, permission checks, and replayable evidence.
			</p>
			<div class="button-row">
				<a class="button" href={`/systems/${featuredProject.id}/`}>View project</a>
				<a class="button secondary" href={featuredProject.data.writeupUrl}>Read essay</a>
			</div>
		</div>
		<div class="flagship-proof">
			<div class="proof-points" aria-label="Agent Reliability project facts">
				<div><strong>24</strong><span>reliability scenarios</span></div>
				<div><strong>6</strong><span>controlled fault modes</span></div>
				<div><strong>Replayable</strong><span>evidence for every failure</span></div>
			</div>
			<SystemFlow steps={reliabilityFlow} label="Agent Reliability testing flow" />
		</div>
	</section>

	<section class="career section-shell" aria-labelledby="career-heading">
		<div class="section-label">
			<h2 id="career-heading">Systems thinking, all the way down.</h2>
			<p>
				My path through analytics, cloud, and infrastructure shapes how I build AI: start with
				evidence, expect failure, and keep humans in the loop.
			</p>
		</div>
		<SystemFlow
			steps={careerFlow}
			label="Career path from analytics through cloud and infrastructure to applied AI"
		/>
	</section>
</SiteLayout>

<style>
	:global(body.site-body) {
		background: #f5f2eb;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.48fr);
		gap: clamp(3rem, 7vw, 7rem);
		align-items: center;
		min-height: calc(100dvh - 72px);
		padding: clamp(3.5rem, 7vw, 6rem) 0;
	}

	.hero-copy {
		display: grid;
		gap: 1.4rem;
	}

	.hero h1 {
		max-width: 920px;
		font-size: clamp(3.4rem, 7.4vw, 7rem);
		letter-spacing: -0.055em;
		line-height: 0.94;
		text-wrap: balance;
	}

	.hero-copy > p:not(.kicker) {
		max-width: 650px;
		color: var(--graphite);
		font-size: clamp(1.05rem, 1.8vw, 1.25rem);
		line-height: 1.55;
	}

	.portrait {
		margin: 0;
	}

	.portrait img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		border: 1px solid var(--line);
		border-radius: 18px;
		box-shadow: 0 30px 80px rgba(17, 19, 24, 0.13);
		object-fit: cover;
		object-position: center 32%;
	}

	.career,
	.flagship {
		border-top: 1px solid var(--line);
		padding: clamp(4rem, 8vw, 7rem) 0;
	}

	.flagship {
		display: grid;
		grid-template-columns: minmax(280px, 0.78fr) minmax(0, 1.22fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: start;
	}

	.section-label,
	.flagship-copy,
	.flagship-proof {
		display: grid;
		gap: 1.2rem;
	}

	.section-label h2,
	.flagship h2 {
		font-size: clamp(2.4rem, 5vw, 4.8rem);
		letter-spacing: -0.045em;
	}

	.flagship-copy > p:not(.plain-label),
	.section-label > p {
		max-width: 620px;
		font-size: 1.08rem;
	}

	.plain-label {
		color: var(--accent);
		font-size: 0.92rem;
		font-weight: 720;
	}

	.proof-points {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		border: 1px solid var(--line);
		border-radius: 18px;
		background: var(--line);
		overflow: hidden;
	}

	.proof-points div {
		display: grid;
		gap: 0.3rem;
		min-height: 132px;
		align-content: center;
		background: rgba(255, 255, 255, 0.72);
		padding: 1.2rem;
	}

	.proof-points strong {
		color: var(--ink);
		font-size: clamp(1.35rem, 2.4vw, 2.15rem);
		letter-spacing: -0.035em;
	}

	.proof-points span {
		color: var(--muted);
		font-size: 0.84rem;
		line-height: 1.35;
	}

	.career {
		display: grid;
		grid-template-columns: minmax(240px, 0.48fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: center;
	}

	.section-label {
		gap: 1rem;
	}

	@media (max-width: 860px) {
		.hero,
		.flagship,
		.career {
			grid-template-columns: 1fr;
		}

		.hero {
			min-height: auto;
		}

		.portrait {
			max-width: 440px;
		}

	}

	@media (max-width: 520px) {
		.hero h1 {
			font-size: clamp(3.15rem, 16vw, 4.7rem);
		}

		.proof-points {
			grid-template-columns: 1fr;
		}
	}
</style>
