---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { getNavigation, getProfile } from '../lib/siteContent';

const profile = getProfile();
const navigation = getNavigation();
---

<header class="site-header">
	<nav class="nav-shell" aria-label="Primary navigation">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span>{profile.name}</span>
		</a>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-links">
			<span class="sr-only">Menu</span>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
		</button>
		<div class="nav-links" id="primary-links">
			{navigation.items.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		</div>
	</nav>
</header>

<script>
	const header = document.querySelector<HTMLElement>('.site-header');
	const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
	const links = header?.querySelector<HTMLElement>('.nav-links');
	const firstLink = links?.querySelector<HTMLAnchorElement>('a');

	if (header && toggle && links) {
		header.classList.add('js-ready');

		const closeMenu = (returnFocus = false) => {
			toggle.setAttribute('aria-expanded', 'false');
			links.dataset.open = 'false';
			if (returnFocus) toggle.focus();
		};

		toggle.addEventListener('click', () => {
			const opening = toggle.getAttribute('aria-expanded') !== 'true';
			toggle.setAttribute('aria-expanded', String(opening));
			links.dataset.open = String(opening);
			if (opening) firstLink?.focus();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				closeMenu(true);
			}
		});

		links.addEventListener('click', (event) => {
			if (event.target instanceof HTMLAnchorElement) closeMenu();
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 30;
		border-bottom: 1px solid rgba(17, 19, 24, 0.08);
		background: rgba(245, 242, 235, 0.86);
		backdrop-filter: blur(18px) saturate(135%);
		-webkit-backdrop-filter: blur(18px) saturate(135%);
	}

	.nav-shell {
		position: relative;
		display: flex;
		width: min(1220px, calc(100% - 48px));
		min-height: var(--header-height);
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		margin: 0 auto;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		color: var(--ink);
		text-decoration: none;
	}

	.brand span {
		font-size: 0.98rem;
		font-weight: 700;
		letter-spacing: 0;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}

	.nav-links a {
		position: relative;
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		color: var(--muted);
		font-size: 0.9rem;
		font-weight: 700;
		padding: 0.55rem 0.74rem;
		transition:
			background 160ms ease,
			color 160ms ease;
	}

	.nav-links a:hover,
	.nav-links a.active {
		background: rgba(251, 250, 247, 0.82);
		color: var(--ink);
	}

	.nav-links a.active::after {
		position: absolute;
		bottom: 3px;
		left: 0.75rem;
		width: calc(100% - 1.5rem);
		height: 2px;
		background: var(--accent);
		content: "";
	}

	.menu-toggle {
		display: none;
		width: 44px;
		height: 44px;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: rgba(251, 250, 247, 0.74);
		cursor: pointer;
	}

	.menu-toggle > span:not(.sr-only) {
		position: absolute;
		width: 18px;
		height: 1.5px;
		background: var(--ink);
		transition: transform 180ms var(--ease-out);
	}

	.menu-toggle > span:nth-child(2) {
		transform: translateY(-4px);
	}

	.menu-toggle > span:nth-child(3) {
		transform: translateY(4px);
	}

	.menu-toggle[aria-expanded="true"] > span:nth-child(2) {
		transform: rotate(45deg);
	}

	.menu-toggle[aria-expanded="true"] > span:nth-child(3) {
		transform: rotate(-45deg);
	}

	@media (max-width: 720px) {
		.nav-shell {
			width: min(100% - 24px, 1220px);
		}

		.js-ready .menu-toggle {
			display: inline-flex;
		}

		.nav-links {
			position: absolute;
			top: calc(100% + 8px);
			right: 0;
			display: grid;
			min-width: min(280px, calc(100vw - 24px));
			width: 100%;
			max-width: 320px;
			border: 1px solid var(--line);
			border-radius: var(--radius);
			background: rgba(251, 250, 247, 0.97);
			box-shadow: 0 22px 60px rgba(17, 19, 24, 0.12);
			padding: 0.5rem;
		}

		.js-ready .nav-links:not([data-open="true"]) {
			display: none;
		}

		.nav-links a {
			width: 100%;
			padding: 0.65rem 0.75rem;
		}

		.nav-links a.active::after {
			top: 50%;
			bottom: auto;
			left: 0;
			width: 2px;
			height: 22px;
			transform: translateY(-50%);
		}
	}
</style>
